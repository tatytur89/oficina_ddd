apiVersion: v1
kind: Secret
metadata:
  name: oficina-api-secret
type: Opaque
stringData:
  SPRING_DATASOURCE_URL: "jdbc:postgresql://REPLACE_WITH_DB_HOST:5432/oficina_db"
  SPRING_DATASOURCE_USERNAME: "REPLACE_WITH_DB_USER"
  SPRING_DATASOURCE_PASSWORD: "REPLACE_WITH_DB_PASSWORD"
  JWT_SECRET: "REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
  ADMIN_USER: "REPLACE_WITH_ADMIN_USER"
  ADMIN_PASSWORD: "REPLACE_WITH_ADMIN_PASSWORD"
