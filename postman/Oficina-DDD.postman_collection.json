{
  "info": {
    "name": "Oficina DDD API",
    "description": "Colecao para testar a API da oficina. Execute Login primeiro; o token sera salvo automaticamente no ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "token", "value": "" },
    { "key": "chaveAcesso", "value": "" },
    { "key": "versaoOrcamento", "value": "0" }
  ],
  "item": [
    {
      "name": "Autenticacao",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.dados && body.dados.token) pm.collectionVariables.set('token', body.dados.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"senha\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8089/api/v1/auth/login",
              "host": ["http://localhost:8089"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Cliente",
      "item": [
        {
          "name": "Cadastrar cliente",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Joao da Silva\",\n  \"documento\": \"12345678909\",\n  \"email\": \"joao@example.com\",\n  \"telefone\": \"11999999999\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "http://localhost:8089/api/v1/clientes", "host": ["http://localhost:8089"], "path": ["api", "v1", "clientes"]}
          }
        },
        {
          "name": "Listar clientes",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/clientes", "host": ["http://localhost:8089"], "path": ["api", "v1", "clientes"]}}
        },
        {
          "name": "Buscar cliente por documento",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/clientes/documento?documento=12345678909", "host": ["http://localhost:8089"], "path": ["api", "v1", "clientes", "documento"], "query": [{"key": "documento", "value": "12345678909"}]}}
        },
        {
          "name": "Atualizar cliente",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Joao da Silva\",\n  \"documento\": \"12345678909\",\n  \"email\": \"joao@example.com\",\n  \"telefone\": \"11999999999\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/clientes/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "clientes", "1"]}
          }
        },
        {
          "name": "Excluir cliente",
          "request": {"method": "DELETE", "url": {"raw": "http://localhost:8089/api/v1/clientes/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "clientes", "1"]}}
        }
      ]
    },
    {
      "name": "Veiculo",
      "item": [
        {
          "name": "Cadastrar veiculo",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"ano\": 2022,\n  \"placa\": \"ABC1D23\",\n  \"clienteId\": 1\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/veiculos", "host": ["http://localhost:8089"], "path": ["api", "v1", "veiculos"]}
          }
        },
        {
          "name": "Listar veiculos",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/veiculos", "host": ["http://localhost:8089"], "path": ["api", "v1", "veiculos"]}}
        },
        {
          "name": "Listar veiculos por cliente",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/veiculos/cliente/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "veiculos", "cliente", "1"]}}
        },
        {
          "name": "Buscar veiculo por placa",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/veiculos/placa/ABC1D23", "host": ["http://localhost:8089"], "path": ["api", "v1", "veiculos", "placa", "ABC1D23"]}}
        },
        {
          "name": "Atualizar veiculo",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"ano\": 2022,\n  \"placa\": \"ABC1D23\",\n  \"clienteId\": 1\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/veiculos/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "veiculos", "1"]}
          }
        },
        {
          "name": "Excluir veiculo",
          "request": {"method": "DELETE", "url": {"raw": "http://localhost:8089/api/v1/veiculos/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "veiculos", "1"]}}
        }
      ]
    },
    {
      "name": "Servico",
      "item": [
        {
          "name": "Cadastrar servico",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Troca de oleo\",\n  \"descricao\": \"Troca de oleo do motor\",\n  \"preco\": 150.00,\n  \"tipo\": \"MANUTENCAO\",\n  \"tempoEstimadoMinutos\": 60\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/servicos", "host": ["http://localhost:8089"], "path": ["api", "v1", "servicos"]}
          }
        },
        {
          "name": "Listar servicos",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/servicos", "host": ["http://localhost:8089"], "path": ["api", "v1", "servicos"]}}
        },
        {
          "name": "Buscar servico por ID",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/servicos/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "servicos", "1"]}}
        },
        {
          "name": "Atualizar servico",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Troca de oleo\",\n  \"descricao\": \"Troca de oleo do motor\",\n  \"preco\": 150.00,\n  \"tipo\": \"MANUTENCAO\",\n  \"tempoEstimadoMinutos\": 60\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/servicos/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "servicos", "1"]}
          }
        },
        {
          "name": "Excluir servico",
          "request": {"method": "DELETE", "url": {"raw": "http://localhost:8089/api/v1/servicos/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "servicos", "1"]}}
        }
      ]
    },
    {
      "name": "Peca",
      "item": [
        {
          "name": "Cadastrar peca",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Filtro de oleo\",\n  \"descricao\": \"Filtro para motor\",\n  \"codigo\": \"FIL001\",\n  \"preco\": 45.90,\n  \"quantidadeEstoque\": 50,\n  \"estoqueMinimo\": 10\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/pecas", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas"]}
          }
        },
        {
          "name": "Listar pecas",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/pecas", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas"]}}
        },
        {
          "name": "Buscar peca por ID",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/pecas/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas", "1"]}}
        },
        {
          "name": "Buscar peca por codigo",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/pecas/codigo/FIL001", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas", "codigo", "FIL001"]}}
        },
        {
          "name": "Atualizar peca",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Filtro de oleo\",\n  \"descricao\": \"Filtro para motor\",\n  \"codigo\": \"FIL001\",\n  \"preco\": 45.90,\n  \"estoqueMinimo\": 10\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/pecas/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas", "1"]}
          }
        },
        {
          "name": "Excluir peca",
          "request": {"method": "DELETE", "url": {"raw": "http://localhost:8089/api/v1/pecas/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas", "1"]}}
        },
        {
          "name": "Repor estoque",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"quantidade\": 10\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/pecas/1/repor-estoque", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas", "1", "repor-estoque"]}
          }
        },
        {
          "name": "Listar estoque baixo",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/pecas/estoque-baixo", "host": ["http://localhost:8089"], "path": ["api", "v1", "pecas", "estoque-baixo"]}}
        }
      ]
    },
    {
      "name": "Ordem de Servico",
      "item": [
        {
          "name": "Criar OS com servicos e pecas solicitados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.dados && body.dados.chaveAcesso) pm.collectionVariables.set('chaveAcesso', body.dados.chaveAcesso);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "description": "Cria a OS em RECEBIDA com snapshots e totais dos itens solicitados, sem previsao de entrega nem baixa de estoque. As listas servicos e pecas podem ser omitidas ou vazias. IDs devem existir no catalogo e quantidades devem ser positivas.",
            "body": {"mode": "raw", "raw": "{\n  \"clienteId\": 1,\n  \"veiculoId\": 1,\n  \"observacoes\": \"Ruido no freio dianteiro\",\n  \"servicos\": [{\"servicoId\": 1, \"quantidade\": 1}],\n  \"pecas\": [{\"pecaId\": 1, \"quantidade\": 1}]\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/ordens-servico", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico"]}
          }
        },
        {
          "name": "Iniciar diagnostico preservando itens da abertura",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "description": "Transiciona RECEBIDA para EM_DIAGNOSTICO e define a previsao. Listas vazias preservam os itens anteriores; itens enviados aqui sao acrescentados, sem substituir nem deduplicar os itens da abertura.",
            "body": {"mode": "raw", "raw": "{\n  \"servicos\": [],\n  \"pecas\": [],\n  \"dataPrevistaEntrega\": \"2026-08-30T18:00:00\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1/diagnostico", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1", "diagnostico"]}
          }
        },
        {
          "name": "Adicionar servico a OS",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"servicoId\": 1,\n  \"quantidade\": 1\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1/servicos", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1", "servicos"]}
          }
        },
        {
          "name": "Adicionar peca a OS",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"pecaId\": 1,\n  \"quantidade\": 1\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1/pecas", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1", "pecas"]}
          }
        },
        {
          "name": "Listar fila operacional por prioridade e antiguidade",
          "request": {"method": "GET", "description": "Prioridade: EM_EXECUCAO > AGUARDANDO_APROVACAO > EM_DIAGNOSTICO > RECEBIDA. Dentro de cada status, data de abertura crescente e ID crescente para desempate. FINALIZADA e ENTREGUE sao omitidas por filtro, sem exclusao dos registros. Historico continua nas consultas por ID, cliente, status e periodo, e nas metricas.", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico"]}}
        },
        {
          "name": "Buscar OS por ID",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1"]}}
        },
        {
          "name": "Listar OS por cliente",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/cliente/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "cliente", "1"]}}
        },
        {
          "name": "Listar OS por status",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/status/RECEBIDA", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "status", "RECEBIDA"]}}
        },
        {
          "name": "Consultar historico de OS finalizadas",
          "request": {"method": "GET", "description": "Consulta OS FINALIZADA que nao aparecem na fila operacional. Para entregues, substitua o status por ENTREGUE; os registros permanecem salvos.", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/status/FINALIZADA", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "status", "FINALIZADA"]}}
        },
        {
          "name": "Listar OS por periodo",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/periodo?inicio=2026-08-01T00:00:00&fim=2026-08-31T23:59:59", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "periodo"], "query": [{"key": "inicio", "value": "2026-08-01T00:00:00"}, {"key": "fim", "value": "2026-08-31T23:59:59"}]}}
        },
        {
          "name": "Enviar orcamento",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  if (body.dados && body.dados.versaoOrcamento !== undefined) pm.collectionVariables.set('versaoOrcamento', body.dados.versaoOrcamento);", "}"]}}],
          "request": {"method": "PATCH", "description": "Exige EM_DIAGNOSTICO com pelo menos um servico. Incrementa a versao do orcamento e limpa a decisao. A resposta salva versaoOrcamento para os callbacks abaixo.", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1/orcamento", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1", "orcamento"]}}
        },
        {
          "name": "Atualizar status da OS",
          "request": {"method": "PATCH", "description": "Transicao administrativa. Nao use EM_EXECUCAO: inicio de execucao exige callback de aprovacao por chave e versao. O exemplo RECEBIDA -> EM_DIAGNOSTICO e uma alternativa ao endpoint de diagnostico, nao deve ser repetido depois dele.", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1/status/EM_DIAGNOSTICO", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1", "status", "EM_DIAGNOSTICO"]}}
        },
        {
          "name": "Acompanhar OS (pagina publica HTML)",
          "request": {"method": "GET", "auth": {"type": "noauth"}, "url": {"raw": "http://localhost:8089/acompanhamento/1?chave={{chaveAcesso}}", "host": ["http://localhost:8089"], "path": ["acompanhamento", "1"], "query": [{"key": "chave", "value": "{{chaveAcesso}}"}]}}
        },
        {
          "name": "Aprovar orcamento por callback JSON (sem JWT)",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "description": "Use apos Enviar orcamento. A chave UUID da OS autentica a chamada, sem JWT. Aprova a versao atual, inicia execucao e baixa estoque. Repeticao da mesma decisao/versao e idempotente, sem nova gravacao nem baixa. Versao diferente, decisao contraditoria ou chave invalida retornam 400. A resposta inclui versaoOrcamento e decisaoOrcamento.",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"chave\": \"{{chaveAcesso}}\",\n  \"versaoOrcamento\": {{versaoOrcamento}},\n  \"aprovado\": true\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1/decisao-orcamento", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1", "decisao-orcamento"]}
          }
        },
        {
          "name": "Recusar orcamento por callback JSON (alternativa, sem JWT)",
          "request": {
            "method": "POST",
            "auth": {"type": "noauth"},
            "description": "Alternativa a aprovacao: nao execute apos aprovar a mesma versao esperando sucesso. A recusa volta a EM_DIAGNOSTICO mantendo os itens, sem baixar estoque. Repeticao identica e idempotente. Apos revisar o diagnostico, execute Enviar orcamento para obter nova versao antes de outra decisao.",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"chave\": \"{{chaveAcesso}}\",\n  \"versaoOrcamento\": {{versaoOrcamento}},\n  \"aprovado\": false\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/1/decisao-orcamento", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "1", "decisao-orcamento"]}
          }
        },
        {
          "name": "Avaliar servico (publico)",
          "request": {"method": "POST", "auth": {"type": "noauth"}, "url": {"raw": "http://localhost:8089/acompanhamento/1/avaliar?chave={{chaveAcesso}}&nota=5&comentario=Otimo atendimento", "host": ["http://localhost:8089"], "path": ["acompanhamento", "1", "avaliar"], "query": [{"key": "chave", "value": "{{chaveAcesso}}"}, {"key": "nota", "value": "5"}, {"key": "comentario", "value": "Otimo atendimento"}]}}
        },
        {
          "name": "Tempo medio de execucao",
          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/metricas/tempo-medio-execucao", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "metricas", "tempo-medio-execucao"]}}
        }
      ]
    }
  ]
}
