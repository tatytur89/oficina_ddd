          "request": {"method": "GET", "url": {"raw": "http://localhost:8089/api/v1/ordens-servico/periodo?inicio=2026-08-01T00:00:00&fim=2026-08-31T23:59:59", "host": ["http://localhost:8089"], "path": ["api", "v1", "ordens-servico", "periodo"], "query": [{"key": "inicio", "value": "2026-08-01T00:00:00"}, {"key": "fim", "value": "2026-08-31T23:59:59"}]}}
