            "url": {"raw": "http://localhost:8089/api/v1/servicos/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "servicos", "1"]}
          }
        },
        {
          "name": "Excluir servico",
          "request": {"method": "DELETE", "url": {"raw": "http://localhost:8089/api/v1/servicos/1", "host": ["http://localhost:8089"], "path": ["api", "v1", "servicos", "1"]}}
